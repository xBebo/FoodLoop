@model FoodLoop.Application.Admin.DashboardSummary
@{ ViewData["Title"] = "Admin dashboard"; }

<div class="page-shell">
    <header class="page-header">
        <div>
            <p class="page-eyebrow mb-1">FoodLoop admin</p>
            <h1 class="page-header__title">Operations overview</h1>
            <p class="page-header__lead">A read-only snapshot of organization, donation and claim activity.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-success" asp-controller="Organizations" asp-action="Manage">Manage organizations</a>
            <a class="btn btn-outline-success" asp-controller="Organizations" asp-action="PendingRequests">Review pending</a>
            <a class="btn btn-outline-success" asp-controller="Courier" asp-action="AssignCourier">Assign courier</a>
            <a class="btn btn-outline-success" asp-action="Audit">View audit log</a>
        </div>
    </header>

    <section class="metric-grid" aria-label="Operational impact summary">
        <article class="metric-card">
            <p class="metric-card__label">Pending organizations</p>
            <p class="metric-card__value" data-testid="pending">@Model.PendingOrganizations</p>
            <p class="metric-card__help">Organizations waiting for approval.</p>
        </article>
        <article class="metric-card">
            <p class="metric-card__label">Current available</p>
            <p class="metric-card__value" data-testid="available">@Model.AvailableDonations</p>
            <p class="metric-card__help">Unexpired listings from active donors.</p>
        </article>
        <article class="metric-card">
            <p class="metric-card__label">Closed operations</p>
            <p class="metric-card__value" data-testid="closed">@Model.ClosedDeliveries</p>
            <p class="metric-card__help">Closed claims with delivery evidence.</p>
        </article>
        <article class="metric-card">
            <p class="metric-card__label">Cancelled claims</p>
            <p class="metric-card__value" data-testid="cancelled">@Model.CancelledClaims</p>
            <p class="metric-card__help">Claims cancelled before courier assignment.</p>
        </article>
        <article class="metric-card">
            <p class="metric-card__label">Expired donations</p>
            <p class="metric-card__value" data-testid="expired">@Model.ExpiredDonations</p>
            <p class="metric-card__help">Donations persisted in the Expired state.</p>
        </article>
    </section>

    <p class="text-muted mt-4 mb-0">Counts refresh when this page reloads. Food quantities are never combined across different units.</p>
</div>
