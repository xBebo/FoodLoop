@using FoodLoop.Domain.Entities
@using FoodLoop.Domain.Enums
@model IEnumerable<Organization>

@{
    ViewData["Title"] = "Organization Management";
    var currentStatus = ViewBag.CurrentStatus as OrganizationStatus?;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Organization Management</h2>
        <a asp-action="PendingRequests" class="btn btn-outline-primary">View Pending Requests</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- 1. فلتر حالة المؤسسة -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <form method="get" asp-action="Organizations" class="row g-3 align-items-center">
                <div class="col-auto">
                    <label class="col-form-label fw-bold">Filter by Status:</label>
                </div>
                <div class="col-auto">
                    <select name="status" class="form-select" onchange="this.form.submit()">
                        <option value="">All Statuses</option>
                        @foreach (OrganizationStatus statusVal in Enum.GetValues(typeof(OrganizationStatus)))
                        {
                            if (currentStatus == statusVal)
                            {
                                <option value="@statusVal" selected="selected">@statusVal</option>
                            }
                            else
                            {
                                <option value="@statusVal">@statusVal</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <a asp-action="Organizations" class="btn btn-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- 2. جدول عرض المؤسسات -->
    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Organization Name</th>
                    <th>Type</th>
                    <th>License Number</th>
                    <th>Status</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">No organizations found matching the criteria.</td>
                    </tr>
                }
                else
                {
                    @foreach (var org in Model)
                    {
                        <tr>
                            <td class="fw-bold">@org.Name</td>
                            <td>@org.Type</td>
                            <td><code>@org.LicenseNumber</code></td>
                            <td>
                                @switch (org.Status)
                                {
                                    case OrganizationStatus.Active:
                                        <span class="badge bg-success">Active</span>
                                        break;
                                    case OrganizationStatus.Suspended:
                                        <span class="badge bg-danger">Suspended</span>
                                        break;
                                    case OrganizationStatus.Pending:
                                        <span class="badge bg-warning text-dark">Pending</span>
                                        break;
                                    case OrganizationStatus.Rejected:
                                        <span class="badge bg-secondary">Rejected</span>
                                        break;
                                    default:
                                        <span class="badge bg-dark">@org.Status</span>
                                        break;
                                }
                            </td>
                            <td class="text-center">
                                @if (org.Status == OrganizationStatus.Active)
                                {
                                    <!-- زر فتح رسالة التأكيد للتعليق -->
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#suspendModal-@org.Id">
                                        Suspend
                                    </button>

                                    <!-- Modal التأكيد مع توضيح الشروط للأدمن -->
                                    <div class="modal fade text-start" id="suspendModal-@org.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <div class="modal-header bg-danger text-white">
                                                    <h5 class="modal-title">Confirm Organization Suspension</h5>
                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <p class="fw-bold">Are you sure you want to suspend "@org.Name"?</p>
                                                    <div class="alert alert-warning mb-0">
                                                        <small>
                                                            <strong>Important Notice:</strong><br />
                                                            Suspending this organization stops all new operations and deliveries for current claims. It does not automatically cancel existing claims. Re-activation will allow valid operations to resume.
                                                        </small>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <form asp-action="SuspendOrganization" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@org.Id" />
                                                        <button type="submit" class="btn btn-danger">Confirm Suspend</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else if (org.Status == OrganizationStatus.Suspended)
                                {
                                    <form asp-action="ReactivateOrganization" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@org.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-success" onclick="return confirm('Are you sure you want to reactivate @org.Name?');">
                                            Reactivate
                                        </button>
                                    </form>
                                }
                                else if (org.Status == OrganizationStatus.Pending)
                                {
                                    <a asp-action="PendingRequests" class="btn btn-sm btn-outline-primary">Review Request</a>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- 3. Server-side Pagination -->
    @if (totalPages > 1)
    {
        <nav aria-label="Organization list navigation" class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Organizations" asp-route-status="@currentStatus" asp-route-page="@(currentPage - 1)">Previous</a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="Organizations" asp-route-status="@currentStatus" asp-route-page="@i">@i</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Organizations" asp-route-status="@currentStatus" asp-route-page="@(currentPage + 1)">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>