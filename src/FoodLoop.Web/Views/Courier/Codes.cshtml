@model IReadOnlyList<FoodLoop.Domain.Entities.DonationClaim>
@using FoodLoop.Domain.Enums

@{ ViewData["Title"] = "Handover codes"; }

<div class="page-shell page-shell--narrow courier-page">
    <header class="page-header">
        <div>
            <p class="page-eyebrow mb-1">Verified handover</p>
            <h1 class="page-header__title">Handover codes</h1>
            <p class="page-header__lead">Generate a one-time code only at handover. Generating another code invalidates the previous one.</p>
        </div>
    </header>

    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    @if (Model.Count == 0)
    {
        <section class="empty-state courier-empty courier-empty--code" aria-labelledby="courier-empty-title">
            <h2 id="courier-empty-title" class="empty-state__title">No handovers awaiting a code</h2>
            <p>No handover-ready claims are available.</p>
        </section>
    }
    else
    {
        <ul class="courier-list" aria-label="Handovers">
            @foreach (var claim in Model)
            {
                <li class="courier-card">
                    <div class="courier-card__head">
                        <h2 class="courier-card__title">@claim.FoodDonation.Title</h2>
                        <span class="status-chip" data-status="@claim.Status">@FoodLoop.Web.Models.ClaimDisplay.Label(claim.Status)</span>
                    </div>

                    <dl class="courier-facts">
                        <div class="courier-facts__wide">
                            <dt>Pickup address</dt>
                            <dd>@claim.FoodDonation.PickupAddress</dd>
                        </div>
                        <div class="courier-facts__wide">
                            <dt>Expires</dt>
                            <dd><time class="courier-expiry" datetime="@FoodLoop.Web.Models.ClaimDisplay.IsoUtc(claim.FoodDonation.ExpiresAtUtc)">@FoodLoop.Web.Models.ClaimDisplay.DisplayUtc(claim.FoodDonation.ExpiresAtUtc)</time></dd>
                        </div>
                    </dl>

                    <p class="courier-card__note">Use the code only with the assigned courier at the current handover step.</p>

                    @if ((User.IsInRole("Donor") && claim.Status == ClaimStatus.PickupPending) ||
                         (User.IsInRole("Beneficiary") && claim.Status == ClaimStatus.InTransit))
                    {
                        <form asp-action="IssueCode" method="post" class="courier-card__actions">
                            <input type="hidden" name="claimId" value="@claim.Id" />
                            <input type="hidden" name="handoverType" value="@(User.IsInRole("Donor") ? HandoverType.Pickup : HandoverType.Delivery)" />
                            <button class="btn btn-primary" type="submit">Generate handover code<span class="visually-hidden">: @claim.FoodDonation.Title</span></button>
                        </form>
                    }
                </li>
            }
        </ul>
    }
</div>
