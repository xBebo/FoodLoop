@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "تعيين مندوب للمهام";
}

<div class="container mt-4">
    <h2>تعيين مندوب توصيل للتبرعات المحجوزة</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success my-3">
            @TempData["SuccessMessage"]
        </div>
    }

    <table class="table table-bordered table-striped mt-3">
        <thead>
            <tr>
                <th>اسم التبرع</th>
                <th>الحالة الحالية</th>
                <th>إجراء التعيين</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                @foreach (var donation in Model)
                {
                    <tr>
                        <td>@donation.Title</td>
                        <td><span class="badge bg-warning">@donation.Status</span></td>
                        <td>
                            <form asp-action="AssignCourier" method="post" class="d-flex gap-2">
                                <input type="hidden" name="donationId" value="@donation.Id" />
                                <input type="text" name="courierId" class="form-control form-control-sm" placeholder="إيميل أو معرف المندوب" required />
                                <button type="submit" class="btn btn-primary btn-sm">تعيين</button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>