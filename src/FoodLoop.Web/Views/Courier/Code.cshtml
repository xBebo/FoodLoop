@model FoodLoop.Web.Models.Courier.HandoverCodeViewModel
@{
    ViewData["Title"] = "Handover code";
}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-body text-center p-4">
                    <p class="text-success fw-semibold mb-1">@Model.HandoverType HANDOVER</p>
                    <h1 class="h3">Your one-time handover code</h1>
                    <p class="text-muted">Show the QR code or copy the same code to the assigned courier. This page displays the raw code only for this issuance.</p>

                    <div class="mx-auto my-4" style="max-width: 260px" role="img" aria-label="QR code containing the handover token">
                        @Html.Raw(Model.QrSvg)
                    </div>

                    <label for="handoverCode" class="form-label fw-semibold">Handover code</label>
                    <div class="input-group mx-auto" style="max-width: 620px">
                        <input id="handoverCode" class="form-control font-monospace" type="text" readonly value="@Model.RawToken" />
                        <button id="copyCode" class="btn btn-primary" type="button">Copy code</button>
                    </div>
                    <p id="copyStatus" class="small mt-2 mb-3" aria-live="polite"></p>

                    <p class="mb-1"><strong>Type:</strong> @Model.HandoverType</p>
                    <p class="mb-4"><strong>Expires:</strong> <time datetime="@Model.ExpiresAtUtc.ToUniversalTime().ToString("O")">@Model.ExpiresAtUtc.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss 'UTC'")</time></p>

                    <div class="alert alert-warning text-start mb-4" role="note">
                        Regenerating a code invalidates the previous one. The server, not this page, decides whether a code is still valid.
                    </div>
                    <a asp-action="Codes" class="btn btn-outline-secondary">Back to handovers</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
(() => {
    const input = document.getElementById('handoverCode');
    const button = document.getElementById('copyCode');
    const status = document.getElementById('copyStatus');

    function showCopied() {
        status.textContent = 'Code copied.';
        status.className = 'small mt-2 mb-3 text-success fw-semibold';
    }

    function fallbackCopy() {
        input.focus();
        input.select();
        input.setSelectionRange(0, input.value.length);
        try {
            if (document.execCommand('copy')) showCopied();
            else throw new Error('copy failed');
        } catch {
            status.textContent = 'Copy was not available. The code is selected so you can copy it manually.';
            status.className = 'small mt-2 mb-3 text-warning';
        }
    }

    button.addEventListener('click', () => {
        if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(input.value).then(showCopied).catch(fallbackCopy);
        } else {
            fallbackCopy();
        }
    });
})();
</script>
