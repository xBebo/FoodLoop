@model FoodLoop.Web.Models.Courier.HandoverCodeViewModel
@{
    ViewData["Title"] = "Handover code";
}

<div class="page-shell courier-page">
    <section class="courier-ticket" aria-labelledby="courier-ticket-title">
        <header class="courier-ticket__head">
            <p class="page-eyebrow mb-2">Handover code</p>
            <span class="fl-tag courier-ticket__type">@Model.HandoverType handover</span>
            <h1 id="courier-ticket-title" class="courier-ticket__title">Your one-time handover code</h1>
            <p class="courier-ticket__lead">Show the QR code or copy the same code to the assigned courier. Keep this page open until the courier has the code.</p>
        </header>

        <div class="courier-qr" role="img" aria-label="QR code containing the handover token">
            @Html.Raw(Model.QrSvg)
        </div>

        <div class="courier-code">
            <label for="handoverCode" class="form-label">Handover code</label>
            <textarea id="handoverCode" class="form-control courier-code__value" rows="3" readonly spellcheck="false">@Model.RawToken</textarea>
            <button id="copyCode" class="btn btn-primary btn-lg courier-code__copy" type="button">Copy code</button>
            <pre class="visually-hidden" aria-hidden="true">@Model.RawToken</pre>
            <p id="copyStatus" class="courier-code__status" aria-live="polite"></p>
        </div>

        <dl class="courier-ticket__meta">
            <div>
                <dt>Type</dt>
                <dd>@Model.HandoverType</dd>
            </div>
            <div>
                <dt>Expires</dt>
                <dd><time datetime="@Model.ExpiresAtUtc.ToUniversalTime().ToString("O")">@Model.ExpiresAtUtc.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss 'UTC'")</time></dd>
            </div>
        </dl>

        <p class="courier-ticket__warning" role="note">
            <svg class="fl-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3 4 6v5c0 5 3.4 8.6 8 10 4.6-1.4 8-5 8-10V6l-8-3Z" /><path d="M12 8v4M12 16h.01" /></svg>
            <span>Regenerating a code invalidates the previous one. Each code can be used once and must be verified before it expires.</span>
        </p>

        <a asp-action="Codes" class="btn btn-outline-secondary courier-ticket__back"><span aria-hidden="true">&larr;</span> Back to handovers</a>
    </section>
</div>

<script>
(() => {
    const input = document.getElementById('handoverCode');
    const button = document.getElementById('copyCode');
    const status = document.getElementById('copyStatus');
    const label = button.textContent;
    let reset;

    function showCopied() {
        status.textContent = 'Code copied.';
        status.className = 'courier-code__status is-success';
        button.textContent = 'Copied ✓';
        clearTimeout(reset);
        reset = setTimeout(() => { button.textContent = label; }, 1500);
    }

    function fallbackCopy() {
        input.focus();
        input.select();
        input.setSelectionRange(0, input.value.length);
        try {
            if (document.execCommand('copy')) showCopied();
            else throw new Error('copy failed');
        } catch {
            status.textContent = 'Copy was not available. The code is selected so you can copy it manually.';
            status.className = 'courier-code__status is-warning';
        }
    }

    button.addEventListener('click', () => {
        if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(input.value).then(showCopied).catch(fallbackCopy);
        } else {
            fallbackCopy();
        }
    });
})();
</script>
