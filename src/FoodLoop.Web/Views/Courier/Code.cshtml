@model FoodLoop.Web.Models.Courier.HandoverCodeViewModel
@{
    ViewData["Title"] = "Handover code";
}

<div class="page-shell">
    <section class="surface-panel handover-code-card p-3 p-md-4 text-center">
        <p class="page-eyebrow mb-1">@Model.HandoverType handover</p>
        <h1 class="page-header__title">Your one-time handover code</h1>
        <p class="page-header__lead mx-auto">Show the QR code or copy the same code to the assigned courier. Keep this page open until the courier has the code.</p>

        <div class="handover-qr" role="img" aria-label="QR code containing the handover token">
            @Html.Raw(Model.QrSvg)
        </div>

        <label for="handoverCode" class="form-label">Handover code</label>
        <div class="input-group mx-auto handover-copy">
            <input id="handoverCode" class="form-control font-monospace" type="text" readonly value="@Model.RawToken" />
            <button id="copyCode" class="btn btn-primary" type="button">Copy code</button>
        </div>
        <pre class="visually-hidden" aria-hidden="true">@Model.RawToken</pre>
        <p id="copyStatus" class="small mt-2 mb-3" aria-live="polite"></p>

        <div class="d-flex flex-wrap justify-content-center gap-3 mb-4 text-start">
            <span class="status-chip"><strong>Type:</strong>&nbsp;@Model.HandoverType</span>
            <span class="status-chip"><strong>Expires:</strong>&nbsp;<time datetime="@Model.ExpiresAtUtc.ToUniversalTime().ToString("O")">@Model.ExpiresAtUtc.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss 'UTC'")</time></span>
        </div>

        <div class="alert alert-warning text-start mb-4" role="note">
            Regenerating a code invalidates the previous one. Each code can be used once and must be verified before it expires.
        </div>

        <a asp-action="Codes" class="btn btn-outline-secondary">Back to handovers</a>
    </section>
</div>

<script>
(() => {
    const input = document.getElementById('handoverCode');
    const button = document.getElementById('copyCode');
    const status = document.getElementById('copyStatus');

    function showCopied() {
        status.textContent = 'Code copied.';
        status.className = 'small mt-2 mb-3 text-success fw-semibold';
    }

    function fallbackCopy() {
        input.focus();
        input.select();
        input.setSelectionRange(0, input.value.length);
        try {
            if (document.execCommand('copy')) showCopied();
            else throw new Error('copy failed');
        } catch {
            status.textContent = 'Copy was not available. The code is selected so you can copy it manually.';
            status.className = 'small mt-2 mb-3 text-warning';
        }
    }

    button.addEventListener('click', () => {
        if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(input.value).then(showCopied).catch(fallbackCopy);
        } else {
            fallbackCopy();
        }
    });
})();
</script>
