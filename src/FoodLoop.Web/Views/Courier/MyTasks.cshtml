@using FoodLoop.Application.Courier
@using FoodLoop.Domain.Enums
@model IEnumerable<CourierTaskItem>

@{
    ViewData["Title"] = "My delivery tasks";
}

<div class="page-shell">
    <header class="page-header">
        <div>
            <p class="page-eyebrow mb-1">Courier workspace</p>
            <h1 class="page-header__title">My delivery tasks</h1>
            <p class="page-header__lead">See where to go next and verify each pickup and delivery.</p>
        </div>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="table-responsive responsive-records">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">Donation</th>
                    <th scope="col">Status</th>
                    <th scope="col">Next step</th>
                    <th scope="col" class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
            @if (Model == null || !Model.Any())
            {
                <tr><td colspan="4" class="text-center py-5 text-muted">No delivery tasks are assigned to you right now.</td></tr>
            }
            else
            {
                @foreach (var task in Model)
                {
                    var closed = task.NextStep == CourierNextStep.Completed;
                    var pickupPending = task.NextStep == CourierNextStep.VerifyPickup;
                    var inTransit = task.NextStep == CourierNextStep.VerifyDelivery;
                    <tr>
                        <td data-label="Donation" class="fw-semibold">@task.DonationTitle
                            <a class="record-link" asp-action="Details" asp-route-id="@task.ClaimId">Task details<span class="visually-hidden">: @task.DonationTitle</span></a></td>
                        <td data-label="Status">
                            @if (closed) { <span class="badge bg-secondary">Closed</span> }
                            else if (inTransit) { <span class="badge bg-warning text-dark">In Transit</span> }
                            else if (pickupPending) { <span class="badge bg-info text-dark">Pickup Pending</span> }
                            else { <span class="badge bg-primary">@task.Status</span> }
                        </td>
                        <td data-label="Next step">
                            @if (pickupPending) { <span>Awaiting pickup verification</span> }
                            else if (inTransit) { <span>Awaiting delivery verification</span> }
                            else if (closed) { <span>Delivery completed</span> }
                            else { <span class="text-muted">No handover action available</span> }
                        </td>
                        <td data-label="Action" class="text-center">
                            @if (closed)
                            {
                                <button class="btn btn-outline-secondary btn-sm" type="button" disabled>Completed</button>
                            }
                            else
                            {
                                <a asp-action="VerifyHandover" asp-route-claimId="@task.ClaimId" class="btn btn-primary btn-sm">Verify handover</a>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
