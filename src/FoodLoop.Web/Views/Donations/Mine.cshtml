@model IReadOnlyList<FoodLoop.Application.Donations.DonationListItem>
@using FoodLoop.Domain.Enums
@functions {
    private static string IsoUtc(DateTimeOffset value) => value.ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ss'Z'");
    private static string DisplayUtc(DateTimeOffset value) => value.ToUniversalTime().ToString("dd MMM yyyy, HH:mm 'UTC'");
}
@{
    ViewData["Title"] = "My Donations";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">My Donations</h1>
            <p class="text-muted mb-0">Your organization's donation drafts and published listings.</p>
        </div>
        <a asp-action="Create" class="btn btn-success">Create Donation</a>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-light border">No donations yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle bg-white">
                <thead class="table-light">
                    <tr>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Quantity</th>
                        <th>Expires</th>
                        <th>Status</th>
                        <th style="width: 190px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>@item.Category</td>
                        <td>@item.Quantity @item.Unit</td>
                        <td><time datetime="@IsoUtc(item.ExpiresAtUtc)">@DisplayUtc(item.ExpiresAtUtc)</time></td>
                        <td><span class="badge text-bg-secondary">@item.Status</span></td>
                        <td>
                            @if (item.Status == DonationStatus.Draft)
                            {
                                <div class="d-flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                    <form asp-action="Publish" asp-route-id="@item.Id" method="post">
                                        <button type="submit" class="btn btn-sm btn-primary">Publish</button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
