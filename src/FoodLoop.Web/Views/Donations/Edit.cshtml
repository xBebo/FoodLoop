@model FoodLoop.Web.Models.Donations.EditDonationViewModel
@{
    ViewData["Title"] = "Edit Draft Donation";
}

<div class="page-shell page-shell--narrow">
    <header class="page-header">
        <div>
            <p class="page-eyebrow mb-1">Donor workspace</p>
            <h1 class="page-header__title">Edit draft donation</h1>
            <p class="page-header__lead">Only a current draft can be saved. If it changes elsewhere, refresh before trying again.</p>
        </div>
    </header>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="surface-panel fl-form-panel">
        <input asp-for="Id" type="hidden" />
        <input asp-for="RowVersion" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <h2 class="form-section-title"><span>01</span> Food details</h2>
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="col-12">
                <label asp-for="FoodCategoryId" class="form-label">Food category</label>
                <select asp-for="FoodCategoryId" asp-items="Model.Categories" class="form-select">
                    <option value="">Choose a category</option>
                </select>
                <span asp-validation-for="FoodCategoryId" class="text-danger"></span>
            </div>

            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="col-6">
                <label asp-for="Quantity" class="form-label"></label>
                <input asp-for="Quantity" class="form-control" step="0.001" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>
            <div class="col-6">
                <label asp-for="Unit" class="form-label"></label>
                <select asp-for="Unit" asp-items="Html.GetEnumSelectList<FoodLoop.Domain.Enums.QuantityUnit>()" class="form-select"></select>
                <span asp-validation-for="Unit" class="text-danger"></span>
            </div>
        </div>

        <h2 class="form-section-title"><span>02</span> Timing &amp; pickup</h2>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="PreparedAt" class="form-label">Prepared at (local time)</label>
                <input asp-for="PreparedAt" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" class="form-control" />
                <span asp-validation-for="PreparedAt" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ExpiresAt" class="form-label">Expires at (local time)</label>
                <input asp-for="ExpiresAt" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" class="form-control" />
                <span asp-validation-for="ExpiresAt" class="text-danger"></span>
            </div>
            <p class="form-text col-12 mt-2 mb-0">Times are entered in local time and stored as UTC.</p>

            <div class="col-12">
                <label asp-for="StorageInstructions" class="form-label">Storage instructions</label>
                <textarea asp-for="StorageInstructions" class="form-control" rows="2"></textarea>
                <span asp-validation-for="StorageInstructions" class="text-danger"></span>
            </div>

            <div class="col-12">
                <label asp-for="PickupAddress" class="form-label">Pickup address</label>
                <input asp-for="PickupAddress" class="form-control" />
                <span asp-validation-for="PickupAddress" class="text-danger"></span>
            </div>
        </div>

        <div class="fl-form-actions">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a asp-action="Mine" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
