@model IReadOnlyList<FoodLoop.Application.Donations.DonationListItem>
@{
    ViewData["Title"] = "Available Donations";
}

<div class="container py-4">
    <h1 class="h3 mb-1">Available Donations</h1>
    <p class="text-muted mb-4">Active, unexpired donations currently available to beneficiaries.</p>

    @if (Model.Count == 0)
    {
        <div class="alert alert-light border">There are no available donations right now.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle bg-white">
                <thead class="table-light">
                    <tr>
                        <th>Donation</th>
                        <th>Donor</th>
                        <th>Category</th>
                        <th>Quantity</th>
                        <th>Pickup</th>
                        <th>Expires</th><th>Claim</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>@item.DonorName</td>
                        <td>@item.Category</td>
                        <td>@item.Quantity @item.Unit</td>
                        <td>@item.PickupAddress</td>
                        <td>@item.ExpiresAtUtc.ToLocalTime().ToString("g")</td>
                        <td><form asp-controller="Claims" asp-action="Create" method="post">
                            <input type="hidden" name="donationId" value="@item.Id" />
                            <button class="btn btn-primary btn-sm">Claim donation</button>
                        </form></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

    }
</div>

@{ var page = ViewBag.Page is int current ? current : 1; }
<nav aria-label="Marketplace pages">
@if (page > 1) { <a asp-action="Available" asp-route-page="@(page-1)">Previous</a> }
@if (Model.Count == 20 && page < int.MaxValue) { <a asp-action="Available" asp-route-page="@(page+1)">Next</a> }
</nav>
