@model FoodLoop.Web.Models.Donations.AvailableDonationsViewModel
@functions {
    private static string IsoUtc(DateTimeOffset value) => value.ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ss'Z'");
    private static string DisplayUtc(DateTimeOffset value) => value.ToUniversalTime().ToString("dd MMM yyyy, HH:mm 'UTC'");

    // Display-only hint beside the absolute UTC time; never used to decide availability or claiming.
    private static TimeSpan TimeLeft(DateTimeOffset expires) => expires - DateTimeOffset.UtcNow;
    private static string RelativeExpiry(DateTimeOffset expires)
    {
        var left = TimeLeft(expires);
        if (left.TotalHours < 1) return "Expires soon";
        if (left.TotalHours < 24) return $"Expires in {(int)left.TotalHours}h";
        var days = (int)left.TotalDays;
        return days == 1 ? "Expires in 1 day" : $"Expires in {days} days";
    }
}
@{
    ViewData["Title"] = "Available Donations";
}

<div class="page-shell">
    <header class="page-header">
        <div>
            <p class="page-eyebrow mb-1">Beneficiary marketplace</p>
            <h1 class="page-header__title">Available donations</h1>
            <p class="page-header__lead">Discover food ready for responsible collection from approved donors. All times are shown in UTC.</p>
        </div>
    </header>

    <form asp-action="Available" method="get" class="fl-toolbar mb-4" role="search">
        <div class="fl-toolbar__field fl-toolbar__field--grow">
            <label for="search" class="form-label">Search title</label>
            <div class="fl-search">
                <svg class="fl-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6.5" /><path d="m20 20-4.35-4.35" /></svg>
                <input id="search" name="search" value="@Model.Search" maxlength="200" class="form-control" placeholder="e.g. Rice" />
            </div>
        </div>
        <div class="fl-toolbar__field">
            <label asp-for="CategoryId" class="form-label">Category</label>
            <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                <option value="">All categories</option>
            </select>
        </div>
        <div class="fl-toolbar__actions">
            <button type="submit" class="btn btn-primary">Filter</button>
            <a asp-action="Available" class="btn btn-outline-secondary">Clear</a>
        </div>
    </form>

    @if (Model.Items.Count == 0)
    {
        <div class="empty-state">
            <h2 class="empty-state__title">Nothing available in this view</h2>
            <p>@(Model.Page == 1 ? "Try another category or clear your search. New donations will appear here when donors publish them." : "No donations are available on this page. Return to the previous page to keep browsing.")</p>
        </div>
    }
    else
    {
        <ul class="fl-market-grid">
            @foreach (var item in Model.Items)
            {
                <li>
                    <article class="fl-donation-card" aria-labelledby="donation-@item.Id">
                        <div class="fl-donation-card__top">
                            <span class="fl-tag">@item.Category</span>
                            <span class="fl-expiry @(TimeLeft(item.ExpiresAtUtc).TotalHours < 6 ? "is-soon" : null)">@RelativeExpiry(item.ExpiresAtUtc)</span>
                        </div>

                        <h2 id="donation-@item.Id" class="fl-donation-card__title">@item.Title</h2>
                        @if (!string.IsNullOrWhiteSpace(item.DonorName))
                        {
                            <p class="fl-donation-card__donor">from @item.DonorName</p>
                        }

                        <dl class="fl-fact-list">
                            <div>
                                <dt>Quantity</dt>
                                <dd class="fl-tabular">@item.Quantity @item.Unit</dd>
                            </div>
                            <div>
                                <dt>Expires</dt>
                                <dd><time datetime="@IsoUtc(item.ExpiresAtUtc)">@DisplayUtc(item.ExpiresAtUtc)</time></dd>
                            </div>
                            <div>
                                <dt>Prepared</dt>
                                <dd><time datetime="@IsoUtc(item.PreparedAtUtc)">@DisplayUtc(item.PreparedAtUtc)</time></dd>
                            </div>
                            <div class="fl-fact-list__wide">
                                <dt>Pickup</dt>
                                <dd class="fl-donation-card__address">@item.PickupAddress</dd>
                            </div>
                        </dl>

                        <form asp-controller="Claims" asp-action="Create" method="post" class="fl-donation-card__action">
                            <input type="hidden" name="donationId" value="@item.Id" />
                            <button class="btn btn-primary w-100">Claim donation</button>
                        </form>
                    </article>
                </li>
            }
        </ul>
    }

    @if (Model.HasPrevious || Model.HasNext)
    {
        <nav class="fl-pager" aria-label="Marketplace pages">
            @if (Model.HasPrevious)
            {
                <a asp-action="Available" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search"
                   asp-route-categoryId="@Model.CategoryId" class="btn btn-outline-secondary"><span aria-hidden="true">&larr;</span> Previous</a>
            }
            <span class="fl-pager__current" aria-current="page">Page @Model.Page</span>
            @if (Model.HasNext)
            {
                <a asp-action="Available" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search"
                   asp-route-categoryId="@Model.CategoryId" class="btn btn-outline-secondary">Next <span aria-hidden="true">&rarr;</span></a>
            }
        </nav>
    }
</div>
