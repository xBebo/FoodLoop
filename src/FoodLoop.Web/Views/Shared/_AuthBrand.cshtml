@* Presentational brand panel shared by the Login and Register screens. *@
<aside class="auth-brand" aria-label="About FoodLoop">
    <svg class="auth-brand__botanical" viewBox="0 0 320 320" fill="none" aria-hidden="true" focusable="false">
        <g stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.25">
            <circle cx="200" cy="200" r="150"/>
            <circle cx="200" cy="200" r="112" stroke-dasharray="1 8" stroke-width="2"/>
            <path d="M40 310C100 260 150 200 170 120"/>
            <path d="M104 256c-26-4-44-22-48-50 26 4 44 22 48 50Z"/>
            <path d="M140 198c6-26 26-42 54-44-6 26-26 42-54 44Z"/>
            <path d="M163 138c-18-16-24-40-16-64 18 16 24 40 16 64Z"/>
