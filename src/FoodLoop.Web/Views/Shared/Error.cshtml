@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="state-panel" aria-labelledby="state-title">
    <span class="state-panel__icon" aria-hidden="true"><svg class="fl-icon" viewBox="0 0 24 24"><path d="M20 12a8 8 0 1 1-2.34-5.66"/><path d="M12 8v4.5M12 16h.01"/></svg></span>
    <p class="page-eyebrow">FoodLoop</p>
    <h1 id="state-title" class="state-panel__title">Something went wrong.</h1>
    <p class="state-panel__lead">We couldn’t complete that request. Please try again in a moment, or return home and continue from there.</p>

    @if (Model.ShowRequestId)
    {
        <p class="state-panel__meta">
            <span>Request ID</span> <code>@Model.RequestId</code>
        </p>
    }

    <div class="state-panel__actions">
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Return home</a>
    </div>
</section>
