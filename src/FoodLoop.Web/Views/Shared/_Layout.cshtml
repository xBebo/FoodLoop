<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FoodLoop.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FoodLoop.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">FoodLoop</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        @if (User.IsInRole(FoodLoop.Application.Identity.AppRoles.Admin))
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Admin" asp-action="Index">Admin dashboard</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Admin" asp-action="Audit">Audit log</a></li>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <li><a class="nav-link" asp-controller="Organizations" asp-action="PendingRequests">Organizations</a></li>
                            <li><a class="nav-link" asp-controller="Courier" asp-action="AssignCourier">Assign courier</a></li>
                        }
                        @if (User.IsInRole("Donor"))
                        {
                            <li><a class="nav-link" asp-controller="Donations" asp-action="Create">Create donation</a></li>
                            <li><a class="nav-link" asp-controller="Donations" asp-action="Mine">My donations</a></li>
                        }
                        @if (User.IsInRole("Beneficiary"))
                        {
                            <li><a class="nav-link" asp-controller="Donations" asp-action="Available">Marketplace</a></li>
                            <li><a class="nav-link" asp-controller="Claims" asp-action="Mine">My claims</a></li>
                        }
                        @if (User.IsInRole("Courier"))
                        { <li><a class="nav-link" asp-controller="Courier" asp-action="MyTasks">My tasks</a></li> }
                        @if (User.IsInRole("Donor") || User.IsInRole("Beneficiary"))
                        { <li><a class="nav-link" asp-controller="Courier" asp-action="Codes">Handover codes</a></li> }
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li><form asp-controller="Auth" asp-action="Logout" method="post"><button class="btn btn-link nav-link">Logout</button></form></li>
                        }
                        else
                        {
                            <li><a class="nav-link" asp-controller="Auth" asp-action="Login">Login</a></li>
                            <li><a class="nav-link" asp-controller="Auth" asp-action="Register">Register</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - FoodLoop - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
