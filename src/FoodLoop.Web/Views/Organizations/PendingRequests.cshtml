@model IEnumerable<FoodLoop.Domain.Entities.Organization>

@{
    ViewData["Title"] = "طلبات الاعتماد المعلقة";
}

<div class="container mt-4">
@if (TempData["ErrorMessage"] is string error) { <p class="alert alert-danger">@error</p> }
    <h2 class="mb-4">طلبات تفعيل المؤسسات المعلقة</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show my-3" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>اسم المؤسسة</th>
                        <th>رقم الترخيص</th>
                        <th>نوع المؤسسة</th>
                        <th>الحالة الحاليّة</th>
                        <th class="text-center">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">لا توجد طلبات معلقة حالياً.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var org in Model)
                        {
                            <tr>
                                <td class="align-middle fw-bold">@org.Name</td>
                                <td class="align-middle">@org.LicenseNumber</td>
                                <td class="align-middle">
                                    <span class="badge bg-info text-dark">@org.Type</span>
                                </td>
                                <td class="align-middle">
                                    <span class="badge bg-warning text-dark">@org.Status</span>
                                </td>
                                <td class="align-middle text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        <!-- قبول الطلب باستدعاء Guid id -->
                                        <form asp-controller="Organizations" asp-action="ApproveOrganization" asp-route-id="@org.Id" method="post">
                                            <button type="submit" class="btn btn-success btn-sm px-3">
                                                <i class="bi bi-check-circle"></i> قبول (Approve)
                                            </button>
                                        </form>

                                        <!-- رفض الطلب باستدعاء Guid id -->
                                        <form asp-controller="Organizations" asp-action="RejectOrganization" asp-route-id="@org.Id" method="post">
                                            <button type="submit" class="btn btn-danger btn-sm px-3">
                                                <i class="bi bi-x-circle"></i> رفض (Reject)
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
