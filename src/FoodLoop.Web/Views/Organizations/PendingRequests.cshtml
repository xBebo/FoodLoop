@model IReadOnlyList<FoodLoop.Application.Organizations.PendingOrganizationItem>

@{
    ViewData["Title"] = "Pending approvals";
}

<div class="page-shell">
    <header class="page-header">
        <div>
            <p class="page-eyebrow mb-1">FoodLoop admin</p>
            <h1 class="page-header__title">Pending organization approvals</h1>
            <p class="page-header__lead">Review each organization before approving access to FoodLoop.</p>
        </div>
        <a class="btn btn-outline-success" asp-action="Manage">Manage organizations</a>
    </header>

    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="status">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="table-responsive responsive-records">
        <table class="table table-hover table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">Organization name</th>
                    <th scope="col">License number</th>
                    <th scope="col">Organization type</th>
                    <th scope="col">Current status</th>
                    <th scope="col" class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">All caught up. No organizations are waiting for approval.</td>
                    </tr>
                }
                else
                {
                    @foreach (var org in Model)
                    {
                        <tr>
                            <td data-label="Name" class="fw-semibold">@org.Name</td>
                            <td data-label="License">@org.LicenseNumber</td>
                            <td data-label="Type"><span class="status-chip">@org.Type</span></td>
                            <td data-label="Status"><span class="badge bg-warning text-dark">Pending</span></td>
                            <td data-label="Actions" class="text-center">
                                <div class="d-flex flex-wrap justify-content-center gap-2">
                                    <form asp-controller="Organizations" asp-action="ApproveOrganization" asp-route-id="@org.Id" method="post">
                                        <button type="submit" class="btn btn-success btn-sm px-3">Approve</button>
                                    </form>
                                    <form asp-controller="Organizations" asp-action="RejectOrganization" asp-route-id="@org.Id" method="post">
                                        <button type="submit" class="btn btn-outline-danger btn-sm px-3">Reject</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
