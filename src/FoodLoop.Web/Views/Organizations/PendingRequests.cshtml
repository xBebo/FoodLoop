@model IEnumerable<FoodLoop.Domain.Entities.Organization>

@{
    ViewData["Title"] = "Pending approvals";
}

<div class="page-shell admin-page">
    <header class="page-header">
        <div>
            <p class="page-eyebrow admin-eyebrow mb-1">Admin workspace</p>
            <h1 class="page-header__title">Pending organization approvals</h1>
            <p class="page-header__lead">Review each organization before approving access to FoodLoop.</p>
        </div>
        <a class="btn btn-outline-brand" asp-action="Manage">Manage organizations</a>
    </header>

    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="status">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <section class="empty-state admin-empty" aria-labelledby="pending-empty-title">
            <h2 id="pending-empty-title" class="empty-state__title">All caught up</h2>
            <p>No organizations are waiting for approval.</p>
        </section>
    }
    else
    {
        <ul class="admin-queue" aria-label="Organizations awaiting approval">
            @foreach (var org in Model)
            {
                <li class="admin-card">
                    <div class="admin-card__head">
                        <h2 class="admin-card__title">@org.Name</h2>
                        <span class="status-chip" data-status="@org.Status">@org.Status</span>
                    </div>
                    <dl class="courier-facts">
                        <div>
                            <dt>Organization type</dt>
                            <dd>@org.Type</dd>
                        </div>
                        <div>
                            <dt>License number</dt>
                            <dd class="admin-mono">@org.LicenseNumber</dd>
                        </div>
                    </dl>
                    <div class="admin-card__actions">
                        <form asp-controller="Organizations" asp-action="ApproveOrganization" asp-route-id="@org.Id" method="post">
                            <button type="submit" class="btn btn-primary">Approve<span class="visually-hidden"> @org.Name</span></button>
                        </form>
                        <form asp-controller="Organizations" asp-action="RejectOrganization" asp-route-id="@org.Id" method="post">
                            <button type="submit" class="btn btn-outline-danger">Reject<span class="visually-hidden"> @org.Name</span></button>
                        </form>
                    </div>
                </li>
            }
        </ul>
    }
</div>
