@model FoodLoop.Web.Models.Organizations.OrganizationProfileViewModel

@{
    ViewData["Title"] = "My Organization Profile";
}

<div class="page-shell page-shell--narrow">
    <header class="page-header">
        <div>
            <p class="page-eyebrow mb-1">Organization</p>
            <h1 class="page-header__title">My organization</h1>
            <p class="page-header__lead">Keep your organization name and pickup or delivery address up to date.</p>
        </div>
        <span class="status-chip" data-status="@Model.Status">@Model.Status</span>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    @if (Model.IsReadOnly)
    {
        <div class="alert alert-warning fl-notice mb-4">
            <svg class="fl-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="5" y="11" width="14" height="9" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>
            <p class="mb-0"><strong>Read-Only Access.</strong> Your organization status is <strong>@Model.Status</strong>, so profile editing is disabled.</p>
        </div>
    }

    <form asp-action="Edit" method="post" class="surface-panel fl-form-panel">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="RowVersion" />
        @if (ViewData["ReturnUrl"] is string returnUrl && !string.IsNullOrWhiteSpace(returnUrl))
        {
            <input type="hidden" name="returnUrl" value="@returnUrl" />
        }

        <h2 class="form-section-title">Profile</h2>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Name" class="form-label">Organization Name</label>
                <input asp-for="Name" class="form-control" readonly="@(Model.IsReadOnly ? "readonly" : null)" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Address" class="form-label">Address</label>
                <textarea asp-for="Address" class="form-control" rows="3" readonly="@(Model.IsReadOnly ? "readonly" : null)"></textarea>
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
        </div>

        <h2 class="form-section-title">Organization details</h2>
        <p class="form-text mt-n2 mb-3">These details are fixed and can't be edited here.</p>
        <div class="row g-3">
            <div class="col-md-6">
                <label for="organization-license" class="form-label">License Number</label>
                <input id="organization-license" class="form-control" value="@Model.LicenseNumber" disabled />
            </div>
            <div class="col-md-6">
                <label for="organization-type" class="form-label">Organization Type</label>
                <input id="organization-type" class="form-control" value="@Model.Type" disabled />
            </div>
        </div>

        @if (!Model.IsReadOnly)
        {
            <div class="fl-form-actions">
                <button type="submit" class="btn btn-primary">Save changes</button>
            </div>
        }
    </form>
</div>
