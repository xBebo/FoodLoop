@{ ViewData["Title"] = "Privacy & responsible use"; }
<section class="page-shell page-shell--narrow">
    <header class="page-header"><div><p class="page-eyebrow">FoodLoop</p><h1 class="page-header__title">Privacy &amp; responsible use</h1><p class="page-header__lead">Share only what is needed to coordinate a food rescue.</p></div></header>
    <div class="surface-panel p-4"><h2 class="h4">Organization information</h2><p>FoodLoop uses organization and account information to manage registrations, donations, claims and courier handovers.</p><h2 class="h4">Handover codes</h2><p>Share a handover code only with the assigned courier. Codes are temporary and can be used once. Avoid including them in screenshots or public messages.</p><h2 class="h4">Activity records</h2><p class="mb-0">Operational actions are recorded for administrator review. Contact your FoodLoop administrator with questions about your account or organization information.</p></div>
</section>
