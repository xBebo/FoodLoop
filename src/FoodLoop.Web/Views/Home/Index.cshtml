@{ ViewData["Title"] = "Good food. Greater impact."; }
<section class="py-5">
    <p class="text-success fw-semibold text-uppercase">FoodLoop</p>
    <h1 class="display-4 fw-bold">Good food.<br />Greater impact.</h1>
    <p class="lead mt-4 col-lg-8">Connecting food donors with approved organizations to give surplus food a useful destination.</p>
    <div class="row g-4 mt-4">
        <div class="col-md-4"><h2 class="h4">Share surplus</h2><p>Make food available for an organization that needs it.</p></div>
        <div class="col-md-4"><h2 class="h4">Coordinate collection</h2><p>Connect each reservation with an assigned courier.</p></div>
        <div class="col-md-4"><h2 class="h4">Document delivery</h2><p>Keep a clear record of collection and handover.</p></div>
    </div>
</section>
