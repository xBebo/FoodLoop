@{
    ViewData["Title"] = "تسجيل حساب مؤسسة جديد";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="card-title mb-0 text-center">تسجيل حساب جديد</h4>
                </div>
                <div class="card-body p-4">

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            <div asp-validation-summary="All" class="text-danger mb-0"></div>
                        </div>
                    }

                    <form asp-controller="Auth" asp-action="Register" method="post">
                        <!-- اسم المؤسسة -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">اسم المؤسسة</label>
                            <input type="text" name="orgName" class="form-control" placeholder="أدخل اسم المؤسسة" required />
                        </div>

                        <!-- رقم الترخيص -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">رقم الترخيص</label>
                            <input type="text" name="licenseNumber" class="form-control" placeholder="أدخل رقم الترخيص الرسمي" required />
                        </div>

                        <!-- اختيار نوع المؤسسة (Donor / Beneficiary) -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">نوع المؤسسة</label>
                            <select name="orgType" class="form-select" required>
                                <option value="" selected disabled>-- اختر نوع المؤسسة --</option>
                                <option value="Donor">مانح (Donor)</option>
                                <option value="Beneficiary">مستفيد (Beneficiary)</option>
                            </select>
                        </div>

                        <!-- البريد الإلكتروني -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">البريد الإلكتروني</label>
                            <input type="email" name="email" class="form-control" placeholder="name@example.com" required />
                        </div>

                        <!-- كلمة المرور -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">كلمة المرور</label>
                            <input type="password" name="password" class="form-control" placeholder="••••••••" required />
                        </div>

                        <!-- زر الإرسال -->
                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">تسجيل الطلب</button>
                        </div>
                    </form>
                </div>
                <div class="card-footer text-center py-3">
                    <small class="text-muted">لديك حساب بالفعل؟ <a asp-controller="Auth" asp-action="Login">تسجيل الدخول</a></small>
                </div>
            </div>
        </div>
    </div>
</div>