@{
    ViewData["Title"] = "Register an organization";
}

<div class="auth-split auth-split--long">
    <partial name="_AuthBrand" />

    <section class="auth-panel" aria-labelledby="auth-title">
        <div class="auth-panel__inner">
            <p class="auth-brandline mb-0">Join FoodLoop</p>
            <h1 id="auth-title" class="auth-title">Register an organization</h1>
            <p class="auth-subtitle">Join as a donor or beneficiary organization. An administrator will review your registration before you can start.</p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="text-danger mb-4"></div>
            }

            <form asp-controller="Auth" asp-action="Register" method="post" class="auth-form">
                <fieldset class="auth-fieldset">
                    <legend class="auth-fieldset__legend"><span aria-hidden="true">01</span>Organization</legend>

                    <div class="mb-3">
                        <label class="form-label" for="orgName">Organization name</label>
                        <input id="orgName" type="text" name="orgName" class="form-control" placeholder="Organization name" autocomplete="organization" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="licenseNumber">License number</label>
                        <input id="licenseNumber" type="text" name="licenseNumber" class="form-control" placeholder="Official license number" required />
                    </div>

                    <div>
                        <label class="form-label" for="orgType">Organization type</label>
                        <select id="orgType" name="orgType" class="form-select" required>
                            <option value="" selected disabled>Choose an organization type</option>
                            <option value="Donor">Donor — share surplus food</option>
                            <option value="Beneficiary">Beneficiary — receive food</option>
                        </select>
                    </div>
                </fieldset>

                <fieldset class="auth-fieldset">
                    <legend class="auth-fieldset__legend"><span aria-hidden="true">02</span>Account</legend>

                    <div class="mb-3">
                        <label class="form-label" for="email">Email address</label>
                        <input id="email" type="email" name="email" class="form-control" placeholder="name@example.com" autocomplete="email" required />
                    </div>

                    <div>
                        <label class="form-label" for="password">Password</label>
                        <input id="password" type="password" name="password" class="form-control" autocomplete="new-password" aria-describedby="passwordHelp" required />
                        <div id="passwordHelp" class="form-text auth-hint">Use at least 10 characters, including uppercase and lowercase letters, a number and a symbol.</div>
                    </div>
                </fieldset>

                <button type="submit" class="btn btn-primary w-100">Submit registration</button>
            </form>

            <p class="auth-switch">
                Already registered?
                <a asp-controller="Auth" asp-action="Login" class="fw-semibold">Welcome back</a>
            </p>
        </div>
    </section>
</div>
