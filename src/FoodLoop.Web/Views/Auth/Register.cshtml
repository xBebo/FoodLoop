@{
    ViewData["Title"] = "تسجيل حساب مؤسسة جديد";
}

<div class="auth-shell" dir="rtl">
    <section class="card auth-card">
        <div class="auth-card__header">
            <p class="auth-brandline mb-0">FoodLoop</p>
            <h1 class="auth-title">تسجيل مؤسسة جديدة</h1>
            <p class="auth-subtitle">أنشئ طلب تسجيل كجهة مانحة أو مستفيدة. سيحتاج الحساب إلى موافقة الإدارة قبل الاستخدام.</p>
        </div>

        <div class="auth-card__body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <div asp-validation-summary="All" class="text-danger mb-0"></div>
                </div>
            }

            <form asp-controller="Auth" asp-action="Register" method="post">
                <div class="mb-3">
                    <label class="form-label">اسم المؤسسة</label>
                    <input type="text" name="orgName" class="form-control" placeholder="اسم المؤسسة" autocomplete="organization" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">رقم الترخيص</label>
                    <input type="text" name="licenseNumber" class="form-control" placeholder="رقم الترخيص الرسمي" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">نوع المؤسسة</label>
                    <select name="orgType" class="form-select" required>
                        <option value="" selected disabled>اختر نوع المؤسسة</option>
                        <option value="Donor">مانح (Donor)</option>
                        <option value="Beneficiary">مستفيد (Beneficiary)</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">البريد الإلكتروني</label>
                    <input type="email" name="email" class="form-control" placeholder="name@example.com" autocomplete="email" required />
                </div>

                <div class="mb-4">
                    <label class="form-label">كلمة المرور</label>
                    <input type="password" name="password" class="form-control" autocomplete="new-password" required />
                    <div class="form-text">استخدم 10 أحرف على الأقل مع حرف كبير وصغير ورقم ورمز.</div>
                </div>

                <button type="submit" class="btn btn-primary w-100">إرسال طلب التسجيل</button>
            </form>

            <p class="text-center text-muted mt-4 mb-0">
                لديك حساب بالفعل؟
                <a asp-controller="Auth" asp-action="Login" class="fw-semibold">تسجيل الدخول</a>
            </p>
        </div>
    </section>
</div>
