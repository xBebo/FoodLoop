@{
    ViewData["Title"] = "تسجيل الدخول";
}

<div class="auth-shell" dir="rtl">
    <section class="card auth-card">
        <div class="auth-card__header">
            <p class="auth-brandline mb-0">FoodLoop</p>
            <h1 class="auth-title">تسجيل الدخول</h1>
            <p class="auth-subtitle">ادخل إلى حسابك لمتابعة عمليات التبرع والاستلام.</p>
        </div>

        <div class="auth-card__body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success" role="status">@TempData["SuccessMessage"]</div>
            }

            <form asp-action="Login" method="post">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                @if (ViewData["ReturnUrl"] is string returnUrl && !string.IsNullOrWhiteSpace(returnUrl))
                {
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                }

                <div class="mb-3">
                    <label class="form-label">البريد الإلكتروني</label>
                    <input type="email" name="email" class="form-control" autocomplete="email" required />
                </div>

                <div class="mb-4">
                    <label class="form-label">كلمة المرور</label>
                    <input type="password" name="password" class="form-control" autocomplete="current-password" required />
                </div>

                <button type="submit" class="btn btn-primary w-100">دخول</button>
            </form>

            <p class="text-center text-muted mt-4 mb-0">
                ليس لديك حساب مؤسسة؟
                <a asp-action="Register" class="fw-semibold">تسجيل مؤسسة جديدة</a>
            </p>
        </div>
    </section>
</div>
